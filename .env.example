# Shourya Kumar Portfolio - Backend Configuration Example
PORT=5000
RECIPIENT_EMAIL=shourya24600101@gmail.com

# Configure at least one mail provider for automatic delivery.

# Resend (recommended): create an API key at https://resend.com/api-keys
RESEND_API_KEY=

# Gmail SMTP alternative. Generate an App Password in your Google Account:
# Security -> 2-Step Verification -> App passwords (do not use your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=shourya24600101@gmail.com
SMTP_PASS=
